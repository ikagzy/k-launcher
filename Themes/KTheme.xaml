<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        K-Launcher design tokens.
        Every colour below is replaced at runtime by ThemeResources.Apply()
        from the active accent palette, so all seven themes keep working.
        Use them with DynamicResource only.
    -->

    <!-- Palette (defaults = Emerald + Cyan) -->
    <Color x:Key="K.AccentColor">#00FF66</Color>
    <Color x:Key="K.Accent2Color">#00D9FF</Color>
    <SolidColorBrush x:Key="K.Bg" Color="#101014"/>
    <SolidColorBrush x:Key="K.Surface" Color="#111116"/>
    <SolidColorBrush x:Key="K.Card" Color="#131319"/>
    <SolidColorBrush x:Key="K.Control" Color="#14191A"/>
    <SolidColorBrush x:Key="K.Outline" Color="#1B1B24"/>
    <SolidColorBrush x:Key="K.OutlineStrong" Color="#2A2A36"/>
    <SolidColorBrush x:Key="K.Accent" Color="#00FF66"/>
    <SolidColorBrush x:Key="K.Accent2" Color="#00D9FF"/>
    <SolidColorBrush x:Key="K.AccentSoft" Color="#2400FF66"/>
    <SolidColorBrush x:Key="K.AccentLine" Color="#6600FF66"/>
    <SolidColorBrush x:Key="K.OnAccent" Color="#0A0D0B"/>

    <!-- Neutrals shared by every theme -->
    <SolidColorBrush x:Key="K.Text" Color="#ECECF1"/>
    <SolidColorBrush x:Key="K.TextMuted" Color="#9A9AA6"/>
    <SolidColorBrush x:Key="K.TextFaint" Color="#686874"/>
    <SolidColorBrush x:Key="K.HoverOverlay" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="K.PressOverlay" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="K.Danger" Color="#FF5C6C"/>
    <SolidColorBrush x:Key="K.DangerSoft" Color="#26FF5C6C"/>
    <SolidColorBrush x:Key="K.Scrim" Color="#99000000"/>

    <!-- Type -->
    <FontFamily x:Key="K.Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="K.Font.Display">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <sys:Double x:Key="K.Size.Caption">11</sys:Double>
    <sys:Double x:Key="K.Size.Small">12</sys:Double>
    <sys:Double x:Key="K.Size.Body">13</sys:Double>
    <sys:Double x:Key="K.Size.Title">17</sys:Double>
    <sys:Double x:Key="K.Size.Display">22</sys:Double>

    <!-- Shape -->
    <CornerRadius x:Key="K.Radius.S">4</CornerRadius>
    <CornerRadius x:Key="K.Radius.M">8</CornerRadius>
    <CornerRadius x:Key="K.Radius.L">12</CornerRadius>
    <CornerRadius x:Key="K.Radius.XL">16</CornerRadius>

    <!-- Motion: one easing for the whole app -->
    <CubicEase x:Key="K.EaseOut" EasingMode="EaseOut"/>
    <Duration x:Key="K.Fast">0:0:0.12</Duration>
    <Duration x:Key="K.Normal">0:0:0.18</Duration>
    <Duration x:Key="K.Press">0:0:0.07</Duration>
    <!-- MotionSettings rescales these three at startup (Fast / Normal / Slow / Off). -->

    <!-- ============================================================ Buttons -->
    <!--
        Implicit button style: every button in the app, including the ones
        built in code, gets rounded corners, a hover sheen, a press dip and a
        keyboard focus ring. Local Background/BorderBrush values still win.
    -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource K.Text}"/>
        <Setter Property="Background" Value="{DynamicResource K.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource K.Outline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource K.Font.Display}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Chrome"
                                CornerRadius="{DynamicResource K.Radius.M}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="Sheen"
                                CornerRadius="{DynamicResource K.Radius.M}"
                                Background="{DynamicResource K.HoverOverlay}"
                                Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="FocusRing"
                                Margin="-3"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource K.AccentLine}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource K.Fast}" EasingFunction="{StaticResource K.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource K.Normal}" EasingFunction="{StaticResource K.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.965" Duration="{StaticResource K.Press}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.965" Duration="{StaticResource K.Press}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource K.Fast}" EasingFunction="{StaticResource K.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource K.Fast}" EasingFunction="{StaticResource K.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource K.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource K.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource K.OnAccent}"/>
    </Style>

    <Style x:Key="K.Button.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>

    <Style x:Key="K.Button.Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource K.AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource K.AccentLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource K.Accent}"/>
    </Style>

    <Style x:Key="K.Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource K.TextMuted}"/>
    </Style>

    <Style x:Key="K.Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource K.DangerSoft}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource K.Danger}"/>
    </Style>

    <!-- ============================================================ Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource K.Text}"/>
        <Setter Property="Background" Value="{DynamicResource K.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource K.Outline}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource K.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource K.Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontFamily" Value="{DynamicResource K.Font.UI}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            CornerRadius="{DynamicResource K.Radius.M}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="VerticalContentAlignment" Value="Center">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Center"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource K.OutlineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource K.AccentLine}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource K.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource K.Font.UI}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    CornerRadius="{DynamicResource K.Radius.S}"
                                    Background="{DynamicResource K.Control}"
                                    BorderBrush="{DynamicResource K.OutlineStrong}"
                                    BorderThickness="1"/>
                            <Border x:Name="Fill"
                                    CornerRadius="{DynamicResource K.Radius.S}"
                                    Background="{DynamicResource K.Accent}"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="FillScale" ScaleX="0.6" ScaleY="0.6"/>
                                </Border.RenderTransform>
                                <Path Data="M3.5,8.2 L6.6,11.2 L12.6,4.8"
                                      Stroke="{DynamicResource K.OnAccent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Border>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource K.AccentLine}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource K.Fast}"/>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource K.Normal}" EasingFunction="{StaticResource K.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource K.Normal}" EasingFunction="{StaticResource K.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource K.Fast}"/>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.6" Duration="{StaticResource K.Fast}"/>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.6" Duration="{StaticResource K.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource K.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Scrollbars -->
    <Style x:Key="K.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource K.OutlineStrong}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource K.TextFaint}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource K.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" Margin="1,2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource K.ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource K.ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource K.ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" Margin="2,1">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource K.ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource K.ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource K.ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ Tooltip -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource K.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource K.Font.UI}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource K.Card}"
                            BorderBrush="{DynamicResource K.OutlineStrong}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource K.Radius.M}"
                            Padding="9,6"
                            MaxWidth="320"
                            Opacity="0">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{StaticResource K.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource K.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource K.Control}"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="3"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Menus -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,5" Background="{DynamicResource K.Outline}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,6" Background="{DynamicResource K.Outline}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Menu item: a soft accent wash plus a short accent rail that grows in
        from the left marks the highlighted row. No effects, so a long menu
        costs no extra render passes.
    -->
    <Style x:Key="LauncherContextMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource K.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7,12,7"/>
        <Setter Property="FontFamily" Value="{DynamicResource K.Font.UI}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="MenuItemRoot"
                                Background="Transparent"
                                CornerRadius="7"
                                Margin="0,1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Margin="16,0,0,0"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource K.TextFaint}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="{DynamicResource K.TextMuted}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <Path x:Name="CheckMark"
                                      Grid.Column="3"
                                      Data="M0,5 L3.5,8.5 L10,1.5"
                                      Stroke="{DynamicResource K.Accent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Highlight"
                                Margin="0,1"
                                CornerRadius="7"
                                Background="{DynamicResource K.AccentSoft}"
                                IsHitTestVisible="False"
                                Opacity="0"/>
                        <Border x:Name="Rail"
                                Width="3"
                                Margin="2,8"
                                HorizontalAlignment="Left"
                                CornerRadius="1.5"
                                Background="{DynamicResource K.Accent}"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5"
                                Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RailScale" ScaleY="0.2"/>
                            </Border.RenderTransform>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right"
                               HorizontalOffset="6"
                               VerticalOffset="-6"
                               PlacementTarget="{Binding ElementName=MenuItemRoot}"
                               PopupAnimation="Fade"
                               StaysOpen="True">
                            <Border Background="{DynamicResource K.Card}"
                                    BorderBrush="{DynamicResource K.OutlineStrong}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="5"
                                    MinWidth="200">
                                <ScrollViewer MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle"
                                                    SnapsToDevicePixels="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource K.Fast}" EasingFunction="{StaticResource K.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource K.Fast}"/>
                                        <DoubleAnimation Storyboard.TargetName="RailScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource K.Normal}" EasingFunction="{StaticResource K.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource K.Normal}" EasingFunction="{StaticResource K.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource K.Fast}"/>
                                        <DoubleAnimation Storyboard.TargetName="RailScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.2" Duration="{StaticResource K.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Highlight" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Menu frame. The part names MenuRoot / MenuSurface / MenuOutline are
        animated from code; they start visible so menus that are opened
        without the animation (tray, text boxes) still show their frame.
    -->
    <Style x:Key="LauncherContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource K.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource K.Font.UI}"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid x:Name="MenuRoot" SnapsToDevicePixels="True">
                        <Border x:Name="MenuSurface"
                                Background="{DynamicResource K.Card}"
                                CornerRadius="10"/>
                        <Border x:Name="MenuOutline"
                                BorderBrush="{DynamicResource K.OutlineStrong}"
                                BorderThickness="1"
                                CornerRadius="10"
                                IsHitTestVisible="False"/>
                        <ScrollViewer Margin="{TemplateBinding Padding}"
                                      MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                            KeyboardNavigation.TabNavigation="Cycle"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource LauncherContextMenuStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource LauncherContextMenuItemStyle}"/>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource LauncherContextMenuItemStyle}"/>

</ResourceDictionary>
