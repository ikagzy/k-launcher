<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Company>itzkagzy</Company>
    <Version>4.1.0</Version>
    <AssemblyVersion>4.1.0.0</AssemblyVersion>
    <FileVersion>4.1.0.0</FileVersion>
    <InformationalVersion>4.1.0</InformationalVersion>
    <ApplicationIcon>Assets\klauncher.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <!-- Memory: no background GC thread/heap and no PGO instrumentation.
         Neither changes anything visible; the heap here is small, so
         foreground collections stay well under a frame. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- the older source copy that lives in this repository must not be compiled into the app -->
    <Compile Remove="Kagzy-Launcher-Source\**" />
    <EmbeddedResource Remove="Kagzy-Launcher-Source\**" />
    <None Remove="Kagzy-Launcher-Source\**" />
    <Page Remove="Kagzy-Launcher-Source\**" />
    <Content Remove="Kagzy-Launcher-Source\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Memory: let the GC compact more readily so the heap commits less. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\ThemeIcons\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Games\Steam\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Backups and patch notes live in Fixes; never compile them. -->
    <Compile Remove="Fixes\**" />
    <Page Remove="Fixes\**" />
    <None Remove="Fixes\**" />
  </ItemGroup>
</Project>
