<Application x:Class="KLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:KLauncher.Services"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <services:LocalizationService x:Key="Localization" />
        <SolidColorBrush x:Key="BgBrush" Color="#101014" />
        <SolidColorBrush x:Key="PanelBrush" Color="#D014141A" />
        <SolidColorBrush x:Key="NeonBrush" Color="#00FF66" />
        <Color x:Key="AccentGlowColor">#00FF66</Color>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#183C2A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7F858C" />
    </Application.Resources>
</Application>
