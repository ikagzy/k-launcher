<Window x:Class="KLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KLauncher"
        Title="K-LAUNCHER"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <local:ShellIconConverter x:Key="ShellIconConverter"/>
        <ControlTemplate x:Key="ThemePaletteButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="PaletteButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    RenderTransformOrigin="0.5,0.5"
                    CornerRadius="5">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource AccentGlowColor}"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PaletteButtonBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.035"
                                                 Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="PaletteButtonBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.035"
                                                 Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="PaletteButtonBorder"
                                                 Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                 To="0.85"
                                                 Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PaletteButtonBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetName="PaletteButtonBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetName="PaletteButtonBorder"
                                                 Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                 To="0"
                                                 Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LauncherContextMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7,14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="MenuItemRoot"
                                    Background="{TemplateBinding Background}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentGlowColor}"
                                                      BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Icon"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               Text="›"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="18"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PlacementTarget="{Binding ElementName=MenuItemRoot}"
                                   PopupAnimation="Slide"
                                   StaysOpen="True">
                                <Border Background="#D215151B"
                                        BorderBrush="#FF00FF66"
                                        BorderThickness="1"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Hidden">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                        KeyboardNavigation.TabNavigation="Cycle"
                                                        SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemRoot"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MenuItemRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.035"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="MenuItemRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.035"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="MenuItemRoot"
                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.8"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MenuItemRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="MenuItemRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="MenuItemRoot"
                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0"
                                                             Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid x:Name="MenuRoot" SnapsToDevicePixels="True">
                            <Border x:Name="MenuSurface"
                                    Background="{TemplateBinding Background}"
                                    Opacity="0"/>
                            <Border x:Name="MenuOutline"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>
                            <ScrollViewer Margin="{TemplateBinding Padding}"
                                          MaxHeight="{x:Static SystemParameters.PrimaryScreenHeight}"
                                          CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Hidden">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                KeyboardNavigation.TabNavigation="Cycle"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainSurface"
            Background="#101014"
            BorderBrush="#143822"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="#111116"
                    BorderBrush="#12311F"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="K-"
                                   Foreground="#00FF66"
                                   FontSize="25"
                                   FontWeight="Bold"/>
                        <TextBlock Text="LAUNCHER"
                                   Foreground="#F2F2F2"
                                   FontSize="25"
                                   FontWeight="Bold"/>

                        <TextBlock Text="1.0"
                                   Foreground="#777780"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,8,8,0"/>
                        <TextBlock Text="BETA"
                                   Foreground="#00FF66"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,8,10,0"/>

                        <Button Content="i"
                                Click="SupportedApplications_Click"
                                Width="21"
                                Height="21"
                                Padding="0"
                                Margin="0,7,0,0"
                                VerticalAlignment="Center"
                                Foreground="#00FF66"
                                Background="#14191A"
                                BorderBrush="#00A94A"
                                BorderThickness="1"
                                FontSize="13"
                                FontWeight="Bold"
                                Cursor="Hand"
                                ToolTip="{Binding [SupportedAppsTooltip], Source={StaticResource Localization}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="InfoButtonBorder"
                                            CornerRadius="12"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{DynamicResource AccentGlowColor}"
                                                              BlurRadius="18"
                                                              ShadowDepth="0"
                                                              Opacity="0"/>
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="InfoButtonBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource AccentHoverBrush}"/>
                                            <Setter TargetName="InfoButtonBorder"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource NeonBrush}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="InfoButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.12"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="InfoButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.12"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="InfoButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                         To="0.9"
                                                                         Duration="0:0:0.14"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="InfoButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1"
                                                                         Duration="0:0:0.11"/>
                                                        <DoubleAnimation Storyboard.TargetName="InfoButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1"
                                                                         Duration="0:0:0.11"/>
                                                        <DoubleAnimation Storyboard.TargetName="InfoButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                         To="0"
                                                                         Duration="0:0:0.11"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="InfoButtonBorder"
                                                    Property="Opacity"
                                                    Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="⚙"
                                Click="Settings_Click"
                                Width="23"
                                Height="23"
                                Padding="0"
                                Margin="6,7,0,0"
                                VerticalAlignment="Center"
                                Foreground="#00FF66"
                                Background="#14191A"
                                BorderBrush="#00A94A"
                                BorderThickness="1"
                                FontFamily="Segoe UI Symbol"
                                FontSize="14"
                                Cursor="Hand"
                                ToolTip="{Binding [SettingsTooltip], Source={StaticResource Localization}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SettingsButtonBorder"
                                            CornerRadius="12"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{DynamicResource AccentGlowColor}"
                                                              BlurRadius="20"
                                                              ShadowDepth="0"
                                                              Opacity="0"/>
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SettingsButtonBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource AccentHoverBrush}"/>
                                            <Setter TargetName="SettingsButtonBorder"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource NeonBrush}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SettingsButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.16"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="SettingsButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.16"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="SettingsButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                         To="1"
                                                                         Duration="0:0:0.14"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SettingsButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1"
                                                                         Duration="0:0:0.11"/>
                                                        <DoubleAnimation Storyboard.TargetName="SettingsButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1"
                                                                         Duration="0:0:0.11"/>
                                                        <DoubleAnimation Storyboard.TargetName="SettingsButtonBorder"
                                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                         To="0"
                                                                         Duration="0:0:0.11"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="SettingsButtonBorder"
                                                    Property="Opacity"
                                                    Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Content="{Binding [AddApp], Source={StaticResource Localization}}"
                                Click="AddApplication_Click"
                                Foreground="#00FF66"
                                Background="#14191A"
                                BorderBrush="#245A38"
                                BorderThickness="1"
                                Padding="12,6"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,22,0"/>

                        <TextBlock Text=""
                                   Foreground="#666670"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>

                        <TextBlock Text="—"
                                   Foreground="#909098"
                                   FontSize="22"
                                   Cursor="Hand"
                                   Margin="0,0,22,0"
                                   MouseLeftButtonDown="Minimize_Click"/>

                        <TextBlock Text="×"
                                   Foreground="#909098"
                                   FontSize="27"
                                   Cursor="Hand"
                                   Margin="0,-4,0,0"
                                   VerticalAlignment="Center"
                                   MouseLeftButtonDown="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- APPS -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Background="#101014">

                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="22"
                                       HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="190"
                                    Height="155"
                                    Margin="9"
                                    Tag="AppCard"
                                    CornerRadius="13"
                                    Background="#131319"
                                    BorderBrush="#1B1B24"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    RenderTransformOrigin="0.5,0.5"
                                    Loaded="AppCard_Loaded"
                                    MouseEnter="Card_MouseEnter"
                                    MouseLeave="Card_MouseLeave"
                                    MouseRightButtonDown="Card_MouseRightButtonDown"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    MouseRightButtonUp="Card_MouseRightButtonUp">

                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="98"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="23"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{Binding FallbackGlyph}"
                                                   Foreground="#00FF66"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=AppIcon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Image x:Name="AppIcon"
                                               Width="68"
                                               Height="68"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Source="{Binding IconPath,
                                                        Converter={StaticResource ShellIconConverter}}"/>

                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding LocalizedName}"
                                               Foreground="#F0F0F0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding [CardMenuHint], Source={StaticResource Localization}}"
                                               Foreground="#00FF66"
                                               FontSize="9"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Background="#111116"
                    BorderBrush="#12311F"
                    BorderThickness="0,1,0,0">

                <Grid Margin="20,0">
                    <TextBlock Text="{Binding [FooterHint], Source={StaticResource Localization}}"
                               Foreground="#4C4C55"
                               FontSize="10"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Made by itzkagzy"
                               Foreground="#00FF66"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>